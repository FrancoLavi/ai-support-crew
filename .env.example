# Application settings
APP_NAME=AI Support Crew
APP_ENV=development
LOG_LEVEL=INFO

# Local development with Gemini through CrewAI/LiteLLM
LLM_PROVIDER=litellm
LLM_MODEL=gemini/gemini-3.5-flash-lite
GEMINI_API_KEY=replace-with-your-gemini-api-key
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY=2

# Optional Amazon Bedrock configuration.
# To use Bedrock, change LLM_PROVIDER to bedrock and set these values.
# Credentials are NOT configured here: boto3 uses the standard AWS chain.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
